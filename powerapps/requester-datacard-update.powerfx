// Requester_DataCard.Update
// A SharePoint Person field expects an SPListExpandedUser record, not just an email.
// Lock or hide the Requester card so users cannot impersonate another requester.
{
    '@odata.type': "#Microsoft.Azure.Connectors.SharePoint.SPListExpandedUser",
    Claims: "i:0#.f|membership|" & Lower(User().Email),
    Department: "",
    DisplayName: User().FullName,
    Email: User().Email,
    JobTitle: "",
    Picture: ""
}
